# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string. The database name MUST be in the path — without
# it the app silently falls back to a different database and your data looks
# missing. Percent-encode any reserved character in the password (@ -> %40).
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/metric_app

# Required. The server refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Comma-separated list of browser origins allowed to call this API.
# Defaults to localhost:3000 when unset — set your deployed frontend URL here.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Falls back to DEMO_KEY, which is limited to 30 requests/hour.
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
